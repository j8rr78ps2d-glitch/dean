'use client'

import { useEffect, useMemo, useState } from 'react'
import {
  Check,
  ChevronLeft,
  ChevronRight,
  ExternalLink,
  FileText,
  MapPin,
  Pencil,
  Plus,
  RotateCcw,
  Trash2,
  X
} from 'lucide-react'
import { sampleData, PEOPLE } from '@/app/data/sample'
import type {
  AppData,
  ChangeItem,
  Person,
  ResourceItem,
  ScheduleItem,
  Show,
  ShowStatus,
  TaskItem,
  TourInfo
} from '@/app/types'

type View = 'today' | 'shows' | 'tasks' | 'resources'
type AddMode = 'schedule' | 'task'

type ExtendedTourInfo = TourInfo & {
  departureCity?: string
  arrivalCity?: string
  equipmentNote?: string

  // 공연 날짜/기간은 자유롭게 입력
  performanceDateText?: string

  // 공연 상세 대시보드 표시 여부
  dashboardVisible?: {
    move?: boolean
    hotel?: boolean
    venue?: boolean
    callTime?: boolean
    performance?: boolean
    localContact?: boolean
    equipment?: boolean
  }
}

type EditTarget =
  | { kind: 'schedule'; item: ScheduleItem }
  | { kind: 'task'; item: TaskItem }
  | { kind: 'resource'; item: ResourceItem }
  | null

function todayKey() {
  const d = new Date()
  const y = d.getFullYear()
  const m = String(d.getMonth() + 1).padStart(2, '0')
  const day = String(d.getDate()).padStart(2, '0')
  return `${y}-${m}-${day}`
}

const TODAY = todayKey()

function fmtDate(date: string) {
  const d = new Date(`${date}T00:00:00`)
  return `${d.getMonth() + 1}/${d.getDate()}`
}

function fmtLongDate(date: string) {
  const d = new Date(`${date}T00:00:00`)
  return `${d.getMonth() + 1}월 ${d.getDate()}일`
}

function dday(date: string) {
  const target = new Date(`${date}T00:00:00`).getTime()
  const today = new Date(`${TODAY}T00:00:00`).getTime()
  return Math.ceil((target - today) / 86400000)
}

function uid() {
  return typeof crypto !== 'undefined' && crypto.randomUUID
    ? crypto.randomUUID()
    : `${Date.now()}-${Math.random()}`
}

function splitRoute(route?: string) {
  if (!route) return ['', '']

  const parts = route.split('→').map(v => v.trim())

  return [
    parts[0] || '',
    parts[1] || ''
  ]
}

export default function Board() {
  const [data, setData] = useState<AppData>(sampleData)
  const [view, setView] = useState<View>('today')
  const [selectedShowId, setSelectedShowId] = useState<string | null>(null)

  const [showEditor, setShowEditor] = useState<{
    open: boolean
    showId?: string
  }>({ open: false })

  const [addModal, setAddModal] = useState(false)
  const [addMode, setAddMode] = useState<AddMode>('schedule')
  const [editTarget, setEditTarget] = useState<EditTarget>(null)
  const [resourceShowId, setResourceShowId] = useState<string | null>(null)
  const [loaded, setLoaded] = useState(false)

  useEffect(() => {
    const saved =
      localStorage.getItem('company-board-data-v2') ||
      localStorage.getItem('company-board-data-v1')

    if (saved) {
      try {
        setData(JSON.parse(saved))
      } catch {}
    }

    setLoaded(true)
  }, [])

  useEffect(() => {
    if (loaded) {
      localStorage.setItem(
        'company-board-data-v2',
        JSON.stringify(data)
      )
    }
  }, [data, loaded])

  const showMap = useMemo(
    () => Object.fromEntries(
      data.shows.map(s => [s.id, s])
    ),
    [data.shows]
  )

  const toggleTask = (id: string) => {
    setData(d => ({
      ...d,
      tasks: d.tasks.map(t =>
        t.id === id
          ? { ...t, done: !t.done }
          : t
      )
    }))
  }

  const deleteTask = (id: string) => {
    setData(d => ({
      ...d,
      tasks: d.tasks.filter(t => t.id !== id)
    }))
  }

  const deleteSchedule = (id: string) => {
    setData(d => ({
      ...d,
      schedules: d.schedules.filter(s => s.id !== id)
    }))
  }

  const deleteResource = (id: string) => {
    setData(d => ({
      ...d,
      resources: d.resources.filter(r => r.id !== id)
    }))
  }

  const resetSample = () => {
    if (
      confirm(
        '현재 입력한 내용을 지우고 샘플 데이터로 되돌릴까요?'
      )
    ) {
      setData(sampleData)
    }
  }

  const addSchedule = (
    item: Omit<ScheduleItem, 'id'>
  ) => {
    setData(d => ({
      ...d,
      schedules: [
        ...d.schedules,
        { ...item, id: uid() }
      ]
    }))
  }

  const addTask = (
    item: Omit<TaskItem, 'id' | 'done'>
  ) => {
    setData(d => ({
      ...d,
      tasks: [
        ...d.tasks,
        {
          ...item,
          id: uid(),
          done: false
        }
      ]
    }))
  }

  const addResource = (
    item: Omit<ResourceItem, 'id'>
  ) => {
    setData(d => ({
      ...d,
      resources: [
        ...d.resources,
        { ...item, id: uid() }
      ]
    }))
  }

  const saveShow = (
    next: Omit<Show, 'id'>,
    id?: string,
    author: Person = PEOPLE[0]
  ) => {
    if (!id) {
      const newId = uid()

      setData(d => ({
        ...d,
        shows: [
          ...d.shows,
          {
            ...next,
            id: newId
          }
        ]
      }))

      setSelectedShowId(newId)
      setShowEditor({ open: false })
      return
    }

    const previous = data.shows.find(s => s.id === id)
    const newChanges: ChangeItem[] = []

    if (previous) {
      const addChange = (
        title: string,
        before?: string,
        after?: string
      ) => {
        const oldValue = before || ''
        const newValue = after || ''

        if (oldValue === newValue) return

        newChanges.push({
          id: uid(),
          showId: id,
          title,
          before: oldValue || '미정',
          after: newValue || '미정',
          author,
          changedAt: new Date().toISOString()
        })
      }

      addChange(
        '공연 상태 변경',
        previous.status,
        next.status
      )

      addChange(
        '대표 공연장 / 장소 변경',
        previous.venue,
        next.venue
      )

      const prevTour = previous.tourInfo as
        | ExtendedTourInfo
        | undefined

      const nextTour = next.tourInfo as
        | ExtendedTourInfo
        | undefined

      if (prevTour && nextTour) {
        const [prevDepartureCity, prevArrivalCity] =
          splitRoute(prevTour.route)

        const [nextDepartureCity, nextArrivalCity] =
          splitRoute(nextTour.route)

        addChange(
          '공연 날짜 변경',
          prevTour.date,
          nextTour.date
        )

        addChange(
          '출발지 변경',
          prevTour.departureCity || prevDepartureCity,
          nextTour.departureCity || nextDepartureCity
        )

        addChange(
          '도착지 변경',
          prevTour.arrivalCity || prevArrivalCity,
          nextTour.arrivalCity || nextArrivalCity
        )

        addChange(
          '출발시간 변경',
          prevTour.departure,
          nextTour.departure
        )

        addChange(
          '도착시간 변경',
          prevTour.arrival,
          nextTour.arrival
        )

        addChange(
          '숙소 변경',
          prevTour.hotel,
          nextTour.hotel
        )

        addChange(
          '체크인 변경',
          prevTour.checkIn,
          nextTour.checkIn
        )

        addChange(
          '공연장 변경',
          prevTour.venue,
          nextTour.venue
        )

        addChange(
          '콜타임 변경',
          prevTour.callTime,
          nextTour.callTime
        )

        addChange(
          '공연시간 변경',
          prevTour.performanceTime,
          nextTour.performanceTime
        )

        addChange(
          '현지 담당자 변경',
          prevTour.localContact,
          nextTour.localContact
        )

        addChange(
          '현지 연락처 변경',
          prevTour.localPhone,
          nextTour.localPhone
        )

        addChange(
          '장비 이동 내용 변경',
          prevTour.equipmentNote,
          nextTour.equipmentNote
        )

        addChange(
          '장비 차량 출발시간 변경',
          prevTour.equipmentDeparture,
          nextTour.equipmentDeparture
        )
      }
    }

    setData(d => ({
      ...d,
      shows: d.shows.map(s =>
        s.id === id
          ? { ...next, id }
          : s
      ),
      changes: [
        ...d.changes,
        ...newChanges
      ]
    }))

    setShowEditor({ open: false })
  }

  const deleteShow = (id: string) => {
    const show = data.shows.find(s => s.id === id)

    if (
      !show ||
      !confirm(
        `‘${show.name}’ 공연과 연결된 일정·할 일·자료를 모두 삭제할까요?`
      )
    ) {
      return
    }

    setData(d => ({
      ...d,
      shows: d.shows.filter(s => s.id !== id),
      schedules: d.schedules.filter(
        s => s.showId !== id
      ),
      tasks: d.tasks.filter(
        t => t.showId !== id
      ),
      resources: d.resources.filter(
        r => r.showId !== id
      ),
      changes: d.changes.filter(
        c => c.showId !== id
      )
    }))

    setSelectedShowId(null)
  }

  const updateSchedule = (
    next: ScheduleItem
  ) => {
    const prev = data.schedules.find(
      s => s.id === next.id
    )

    const newChanges: ChangeItem[] = []

    if (prev) {
      if (
        prev.startTime !== next.startTime ||
        prev.endTime !== next.endTime
      ) {
        newChanges.push({
          id: uid(),
          showId: next.showId,
          title: `${next.title} 시간 변경`,
          before: `${prev.startTime}${
            prev.endTime
              ? `–${prev.endTime}`
              : ''
          }`,
          after: `${next.startTime}${
            next.endTime
              ? `–${next.endTime}`
              : ''
          }`,
          author: next.author,
          changedAt: new Date().toISOString()
        })
      }

      if (
        (prev.location || '') !==
        (next.location || '')
      ) {
        newChanges.push({
          id: uid(),
          showId: next.showId,
          title: `${next.title} 장소 변경`,
          before: prev.location || '미정',
          after: next.location || '미정',
          author: next.author,
          changedAt: new Date().toISOString()
        })
      }

      if (prev.date !== next.date) {
        newChanges.push({
          id: uid(),
          showId: next.showId,
          title: `${next.title} 날짜 변경`,
          before: fmtDate(prev.date),
          after: fmtDate(next.date),
          author: next.author,
          changedAt: new Date().toISOString()
        })
      }
    }

    setData(d => ({
      ...d,
      schedules: d.schedules.map(s =>
        s.id === next.id ? next : s
      ),
      changes: [
        ...d.changes,
        ...newChanges
      ]
    }))

    setEditTarget(null)
  }

  const updateTask = (
    next: TaskItem
  ) => {
    setData(d => ({
      ...d,
      tasks: d.tasks.map(t =>
        t.id === next.id ? next : t
      )
    }))

    setEditTarget(null)
  }

  const updateResource = (
    next: ResourceItem
  ) => {
    setData(d => ({
      ...d,
      resources: d.resources.map(r =>
        r.id === next.id ? next : r
      )
    }))

    setEditTarget(null)
  }

  const openShow = (id: string) => {
    setSelectedShowId(id)
    setView('shows')
  }

  const goTop = (next: View) => {
    setSelectedShowId(null)
    setShowEditor({ open: false })
    setView(next)
  }

  return (
    <div className="min-h-screen pb-28 md:pb-10">

      <header className="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div className="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 md:px-8">

          <div>
            <div className="text-[11px] font-bold tracking-[0.22em] text-slate-500">
              COMPANY BOARD
            </div>

            <div className="mt-0.5 text-sm font-semibold text-slate-900">
              공연 제작 운영판
            </div>
          </div>

          <nav className="hidden items-center gap-1 md:flex">
            {([
              ['today', '오늘'],
              ['shows', '공연'],
              ['tasks', '할 일'],
              ['resources', '자료']
            ] as [View, string][]).map(
              ([k, label]) => (
                <button
                  key={k}
                  onClick={() => goTop(k)}
                  className={`rounded-md px-4 py-2 text-sm font-semibold ${
                    view === k
                      ? 'bg-slate-900 text-white'
                      : 'text-slate-600 hover:bg-slate-100'
                  }`}
                >
                  {label}
                </button>
              )
            )}
          </nav>

          <button
            onClick={resetSample}
            className="flex items-center gap-1.5 rounded-md border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50"
          >
            <RotateCcw size={14} />
            샘플 복원
          </button>

        </div>
      </header>

      <main className="mx-auto max-w-6xl px-5 py-7 md:px-8 md:py-10">

        {view === 'today' && (
          <TodayView
            data={data}
            showMap={showMap}
            toggleTask={toggleTask}
            openShow={openShow}
          />
        )}

        {view === 'shows' &&
          showEditor.open && (
            <ShowEditor
              data={data}
              showId={showEditor.showId}
              onBack={() =>
                setShowEditor({ open: false })
              }
              onSave={saveShow}
            />
          )}

        {view === 'shows' &&
          !showEditor.open &&
          !selectedShowId && (
            <ShowsView
              data={data}
              openShow={openShow}
              onAdd={() =>
                setShowEditor({ open: true })
              }
            />
          )}

        {view === 'shows' &&
          !showEditor.open &&
          selectedShowId && (
            <ShowDetail
              data={data}
              showId={selectedShowId}
              onBack={() =>
                setSelectedShowId(null)
              }
              toggleTask={toggleTask}
              deleteTask={deleteTask}
              deleteSchedule={deleteSchedule}
              deleteResource={deleteResource}
              onEditShow={() =>
                setShowEditor({
                  open: true,
                  showId: selectedShowId
                })
              }
              onDeleteShow={() =>
                deleteShow(selectedShowId)
              }
              onEdit={setEditTarget}
              onAddResource={() =>
                setResourceShowId(
                  selectedShowId
                )
              }
            />
          )}

        {view === 'tasks' && (
          <TasksView
            data={data}
            showMap={showMap}
            toggleTask={toggleTask}
            deleteTask={deleteTask}
            onEdit={item =>
              setEditTarget({
                kind: 'task',
                item
              })
            }
          />
        )}

        {view === 'resources' && (
          <ResourcesView
            data={data}
            onEdit={item =>
              setEditTarget({
                kind: 'resource',
                item
              })
            }
            onDelete={deleteResource}
            onAdd={showId =>
              setResourceShowId(showId)
            }
          />
        )}

      </main>

      {!showEditor.open && (
        <button
          onClick={() =>
            setAddModal(true)
          }
          className="fixed bottom-20 right-5 z-40 flex items-center gap-2 rounded-full bg-slate-900 px-5 py-3.5 text-sm font-bold text-white shadow-soft md:bottom-8 md:right-8"
        >
          <Plus size={18} />
          일정 / 할 일 추가
        </button>
      )}

      <div className="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white md:hidden">
        <div className="grid grid-cols-4">

          {([
            ['today', '오늘'],
            ['shows', '공연'],
            ['tasks', '할 일'],
            ['resources', '자료']
          ] as [View, string][]).map(
            ([k, label]) => (
              <button
                key={k}
                onClick={() => goTop(k)}
                className={`py-3 text-xs font-bold ${
                  view === k
                    ? 'text-slate-950'
                    : 'text-slate-400'
                }`}
              >
                {label}
              </button>
            )
          )}

        </div>
      </div>

      {addModal && (
        <AddModal
          data={data}
          mode={addMode}
          setMode={setAddMode}
          onClose={() =>
            setAddModal(false)
          }
          addSchedule={addSchedule}
          addTask={addTask}
        />
      )}

      {editTarget?.kind ===
        'schedule' && (
        <ScheduleEditModal
          item={editTarget.item}
          data={data}
          onClose={() =>
            setEditTarget(null)
          }
          onSave={updateSchedule}
        />
      )}

      {editTarget?.kind ===
        'task' && (
        <TaskEditModal
          item={editTarget.item}
          data={data}
          onClose={() =>
            setEditTarget(null)
          }
          onSave={updateTask}
        />
      )}

      {editTarget?.kind ===
        'resource' && (
        <ResourceModal
          data={data}
          item={editTarget.item}
          onClose={() =>
            setEditTarget(null)
          }
          onSave={item =>
            updateResource(
              item as ResourceItem
            )
          }
        />
      )}

      {resourceShowId && (
        <ResourceModal
          data={data}
          initialShowId={
            resourceShowId
          }
          onClose={() =>
            setResourceShowId(null)
          }
          onSave={item => {
            addResource(
              item as Omit<
                ResourceItem,
                'id'
              >
            )

            setResourceShowId(null)
          }}
        />
      )}

    </div>
  )
}

function Section({
  title,
  children
}: {
  title: string
  children: React.ReactNode
}) {
  return (
    <section>
      <h2 className="mb-3 text-lg font-bold text-slate-950">
        {title}
      </h2>

      <div className="rounded-lg border border-slate-200 bg-white">
        {children}
      </div>
    </section>
  )
}

function Empty({
  text
}: {
  text: string
}) {
  return (
    <div className="px-4 py-8 text-center text-sm text-slate-400">
      {text}
    </div>
  )
}

function IconButton({
  label,
  onClick,
  danger = false
}: {
  label: string
  onClick: () => void
  danger?: boolean
}) {
  return (
    <button
      onClick={onClick}
      className={`inline-flex items-center gap-1 rounded-md px-2 py-1.5 text-xs font-bold ${
        danger
          ? 'text-rose-600 hover:bg-rose-50'
          : 'text-slate-500 hover:bg-slate-100'
      }`}
    >
      {danger
        ? <Trash2 size={13} />
        : <Pencil size={13} />
      }

      {label}
    </button>
  )
}

function TodayView({
  data,
  showMap,
  toggleTask,
  openShow
}: {
  data: AppData
  showMap: Record<string, Show>
  toggleTask: (id: string) => void
  openShow: (id: string) => void
}) {
  const todaySchedules =
    data.schedules
      .filter(
        s => s.date === TODAY
      )
      .sort(
        (a, b) =>
          a.startTime.localeCompare(
            b.startTime
          )
      )

  const todayTasks =
    data.tasks.filter(
      t => t.dueDate === TODAY
    )

  const upcoming =
    data.shows
      .map(show => ({
        show,
        next:
          data.schedules
            .filter(
              s =>
                s.showId ===
                  show.id &&
                s.date >= TODAY
            )
            .sort(
              (a, b) =>
                a.date.localeCompare(
                  b.date
                ) ||
                a.startTime.localeCompare(
                  b.startTime
                )
            )[0]
      }))
      .filter(x => x.next)
      .slice(0, 4)

  const changes =
    [...data.changes]
      .sort(
        (a, b) =>
          b.changedAt.localeCompare(
            a.changedAt
          )
      )
      .slice(0, 3)

  const d =
    new Date(
      `${TODAY}T00:00:00`
    )

  const weekday =
    [
      '일',
      '월',
      '화',
      '수',
      '목',
      '금',
      '토'
    ][d.getDay()]

  return (
    <div>

      <div className="mb-8">

        <div className="text-sm font-semibold text-slate-500">
          {d.getMonth() + 1}월{' '}
          {d.getDate()}일{' '}
          {weekday}요일
        </div>

        <h1 className="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">
          오늘 필요한 것만
        </h1>

      </div>

      <div className="grid gap-6 lg:grid-cols-2">

        <Section title="오늘 일정">

          {todaySchedules.length ===
          0 ? (
            <Empty text="오늘 일정이 없습니다." />
          ) : (
            todaySchedules.map(
              (s, i) => (
                <div
                  key={s.id}
                  className={`grid grid-cols-[64px_1fr] gap-4 px-4 py-4 ${
                    i
                      ? 'border-t border-slate-100'
                      : ''
                  }`}
                >

                  <div className="pt-0.5 text-lg font-extrabold tabular-nums text-slate-950">
                    {s.startTime}
                  </div>

                  <div>

                    <button
                      onClick={() =>
                        openShow(
                          s.showId
                        )
                      }
                      className="text-xs font-bold text-slate-500 hover:text-slate-900"
                    >
                      {
                        showMap[
                          s.showId
                        ]?.name
                      }
                    </button>

                    <div className="mt-1 font-bold text-slate-950">
                      {s.title}
                    </div>

                    {s.location && (
                      <div className="mt-1 flex items-center gap-1 text-sm text-slate-500">
                        <MapPin
                          size={13}
                        />
                        {s.location}
                      </div>
                    )}

                  </div>

                </div>
              )
            )
          )}

        </Section>

        <Section title="오늘 할 일">

          {todayTasks.length ===
          0 ? (
            <Empty text="오늘 마감 할 일이 없습니다." />
          ) : (
            todayTasks.map(
              (t, i) => (
                <TaskRow
                  key={t.id}
                  t={t}
