                    />

                  </Field>

                </div>

                <DashboardCheck value="equipment" />

              </div>

            </div>

          </div>

        </div>

        <div className="mt-8 flex justify-end gap-2 border-t border-slate-200 pt-6">

          <button
            onClick={onBack}
            className="rounded-lg border border-slate-200 px-4 py-3 text-sm font-bold"
