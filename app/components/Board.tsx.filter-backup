function ShowDetail({
  data,
  showId,
  onBack,
  toggleTask,
  deleteTask,
  deleteSchedule,
  deleteResource,
  onEditShow,
  onDeleteShow,
  onEdit,
  onAddResource
}: {
  data: AppData
  showId: string
  onBack: () => void
  toggleTask: (id: string) => void
  deleteTask: (id: string) => void
  deleteSchedule: (id: string) => void
  deleteResource: (id: string) => void
  onEditShow: () => void
  onDeleteShow: () => void
  onEdit: (target: EditTarget) => void
  onAddResource: () => void
}) {
  const show =
    data.shows.find(
      s => s.id === showId
    )

  if (!show) return null

  const schedules =
    data.schedules
      .filter(
        s => s.showId === showId
      )
      .sort(
        (a, b) =>
          a.date.localeCompare(
            b.date
          ) ||
          a.startTime.localeCompare(
            b.startTime
          )
      )

  const tasks =
    data.tasks.filter(
      t => t.showId === showId
    )

  const resources =
    data.resources.filter(
      r => r.showId === showId
    )

  const changes =
    data.changes
      .filter(
        c => c.showId === showId
      )
      .sort(
        (a, b) =>
          b.changedAt.localeCompare(
            a.changedAt
          )
      )

  return (
    <div>

      <button
        onClick={onBack}
        className="mb-5 flex items-center gap-1 text-sm font-bold text-slate-500 hover:text-slate-950"
      >
        <ChevronLeft size={16} />
        공연 목록
      </button>

      <div className="mb-8 flex flex-wrap items-end justify-between gap-4">

        <div>

          <div className="text-sm font-bold text-slate-500">
            {show.status}
          </div>

          <h1 className="mt-1 text-3xl font-extrabold tracking-tight">
            {show.name}
          </h1>

          {show.venue && (
            <div className="mt-2 flex items-center gap-1 text-sm text-slate-500">
              <MapPin size={14} />
              {show.venue}
            </div>
          )}

        </div>

        <div className="flex gap-2">

          <button
            onClick={
              onEditShow
            }
            className="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-bold"
          >
            <Pencil
              size={15}
            />
            공연 정보 수정
          </button>

          <button
            onClick={
              onDeleteShow
            }
            className="inline-flex items-center gap-1.5 rounded-lg border border-rose-200 bg-white px-3 py-2.5 text-sm font-bold text-rose-600"
          >
            <Trash2
              size={15}
            />
            삭제
          </button>

        </div>

      </div>

      {show.type ===
        'tour' &&
        show.tourInfo && (
          <TourPanel
            show={show}
          />
        )}

      <div className="mt-7 grid gap-6 lg:grid-cols-2">

        <Section title="일정">

          {schedules.length ===
          0 ? (
            <Empty text="등록된 일정이 없습니다." />
          ) : (
            schedules.map(
              (s, i) => (
                <div
                  key={s.id}
                  className={`flex items-start justify-between gap-3 px-4 py-4 ${
                    i
                      ? 'border-t border-slate-100'
                      : ''
                  }`}
                >

                  <div className="min-w-0">

                    <div className="text-xs font-bold text-slate-500">
                      {fmtDate(
                        s.date
                      )}{' '}
                      ·{' '}
                      {s.startTime}
                      {s.endTime
                        ? `–${s.endTime}`
                        : ''
                      }
                    </div>

                    <div className="mt-1 font-bold">
                      {s.title}
                    </div>

                    {s.location && (
                      <div className="mt-1 text-sm text-slate-500">
                        {s.location}
                      </div>
                    )}

                  </div>

                  <div className="flex shrink-0">

                    <IconButton
                      label="수정"
                      onClick={() =>
                        onEdit({
                          kind:
                            'schedule',
                          item: s
                        })
                      }
                    />

                    <IconButton
                      label="삭제"
                      danger
