function ShowEditor({
  data,
  showId,
  onBack,
  onSave
}: {
  data: AppData
  showId?: string
  onBack: () => void
  onSave: (
    show: Omit<Show, 'id'>,
    id?: string,
    author?: Person
  ) => void
}) {
  const existing =
    showId
      ? data.shows.find(s => s.id === showId)
      : undefined

  const existingTour =
    existing?.tourInfo as ExtendedTourInfo | undefined

  const [oldDeparture, oldArrival] =
    splitRoute(existingTour?.route)

  const defaultVisible = {
    move: true,
    hotel: true,
    venue: true,
    callTime: true,
    performance: true,
    localContact: false,
    equipment: false
  }

  const blankTour: ExtendedTourInfo = {
    date: TODAY,
    performanceDateText: '',
    route: '',
    departureCity: '',
    arrivalCity: '',
    departure: '',
    arrival: '',
    hotel: '',
    checkIn: '',
    venue: '',
    callTime: '',
    performanceTime: '',
    localContact: '',
    localPhone: '',
    equipmentNote: '',
    equipmentDeparture: '',
    dashboardVisible: defaultVisible
  }

  const initialTour: ExtendedTourInfo =
    existingTour
      ? {
          ...blankTour,
          ...existingTour,

          performanceDateText:
            existingTour.performanceDateText ||
            (
              existingTour.date
                ? fmtLongDate(existingTour.date)
                : ''
            ),

          departureCity:
            existingTour.departureCity ||
            oldDeparture,

          arrivalCity:
            existingTour.arrivalCity ||
            oldArrival,

          dashboardVisible: {
            ...defaultVisible,
            ...(existingTour.dashboardVisible || {})
          }
        }
      : blankTour

  const [name, setName] =
    useState(existing?.name || '')

  const [status, setStatus] =
    useState<ShowStatus>(
      existing?.status || '준비 중'
    )

  const [type, setType] =
    useState<'general' | 'tour'>(
      existing?.type || 'general'
    )

  const [venue, setVenue] =
    useState(existing?.venue || '')

  const [author, setAuthor] =
    useState<Person>(PEOPLE[0])

  const [tour, setTour] =
    useState<ExtendedTourInfo>(initialTour)

  const setT = (
    key: keyof ExtendedTourInfo,
    value: string
  ) => {
    setTour(t => ({
      ...t,
      [key]: value
    }))
  }

  const setVisible = (
    key:
      | 'move'
      | 'hotel'
      | 'venue'
      | 'callTime'
      | 'performance'
      | 'localContact'
      | 'equipment',
    checked: boolean
  ) => {
    setTour(t => ({
      ...t,
      dashboardVisible: {
        ...defaultVisible,
        ...(t.dashboardVisible || {}),
        [key]: checked
      }
    }))
  }

  const isVisible = (
    key:
      | 'move'
      | 'hotel'
      | 'venue'
      | 'callTime'
      | 'performance'
      | 'localContact'
      | 'equipment'
  ) => {
    return (
      tour.dashboardVisible?.[key] ??
      defaultVisible[key]
    )
  }

  const DashboardCheck = ({
    value
  }: {
    value:
      | 'move'
      | 'hotel'
      | 'venue'
      | 'callTime'
      | 'performance'
      | 'localContact'
      | 'equipment'
  }) => (
    <label className="mt-2 inline-flex cursor-pointer items-center gap-2 text-xs font-bold text-slate-500">

      <input
        type="checkbox"
        checked={isVisible(value)}
        onChange={e =>
          setVisible(
            value,
            e.target.checked
          )
        }
        className="h-4 w-4 rounded border-slate-300"
      />

      대시보드 표시

    </label>
  )

  const save = () => {
    if (!name.trim()) {
      return alert(
        '공연 이름을 입력해 주세요.'
      )
    }

    const normalizedTour: ExtendedTourInfo = {
      ...tour,

      route:
        `${
          tour.departureCity || ''
        } → ${
          tour.arrivalCity || ''
        }`,

      dashboardVisible: {
        ...defaultVisible,
        ...(tour.dashboardVisible || {})
      }
    }

    const hasTourInfo = Boolean(
      tour.performanceDateText?.trim() ||
      tour.departureCity?.trim() ||
      tour.arrivalCity?.trim() ||
      tour.departure?.trim() ||
      tour.arrival?.trim() ||
      tour.hotel?.trim() ||
      tour.checkIn?.trim() ||
      tour.venue?.trim() ||
      tour.callTime?.trim() ||
      tour.performanceTime?.trim() ||
      tour.localContact?.trim() ||
      tour.localPhone?.trim() ||
      tour.equipmentNote?.trim() ||
      tour.equipmentDeparture?.trim()
    )

    const finalType =
      type === 'tour' || hasTourInfo
        ? 'tour'
        : 'general'

    onSave(
      {
        name: name.trim(),
        status,
        type: finalType,
        venue:
          venue.trim() ||
          undefined,

        tourInfo:
          finalType === 'tour'
            ? normalizedTour
            : undefined
      },
      showId,
      author
    )
  }

  return (
    <div className="mx-auto max-w-3xl">

      <button
        onClick={onBack}
        className="mb-5 flex items-center gap-1 text-sm font-bold text-slate-500"
      >
        <ChevronLeft size={16} />

        {existing
          ? '공연 상세'
          : '공연 목록'
        }
      </button>

      <div className="mb-8">

        <div className="text-sm font-semibold text-slate-500">
          {existing
            ? '공연 수정'
            : '새 공연 만들기'
          }
        </div>

        <h1 className="mt-1 text-3xl font-extrabold tracking-tight">
          {existing
            ? existing.name
            : '공연 정보 입력'
          }
        </h1>

      </div>

      <div className="rounded-lg border border-slate-200 bg-white p-5 md:p-7">

        <div className="grid gap-5">

          <div className="text-lg font-extrabold">
            기본 정보
          </div>

          <Field label="공연 이름">

            <input
              className="input"
              value={name}
              onChange={e =>
                setName(e.target.value)
              }
              placeholder="예: 으랏차차 스토리"
            />

          </Field>

          <div className="grid gap-4 sm:grid-cols-2">

            <Field label="상태">

              <select
                className="input"
                value={status}
                onChange={e =>
                  setStatus(
                    e.target.value as ShowStatus
                  )
                }
              >
                <option>준비 중</option>
                <option>진행 중</option>
                <option>투어 중</option>
              </select>

            </Field>

            <Field label="공연 형태">

              <select
                className="input"
                value={type}
                onChange={e =>
                  setType(
                    e.target.value as
                      | 'general'
                      | 'tour'
                  )
                }
              >
                <option value="general">
                  일반 공연
                </option>

                <option value="tour">
                  지방공연 / 투어
                </option>
              </select>

            </Field>

          </div>

          <Field label="대표 공연장 / 장소">

            <input
              className="input"
              value={venue}
              onChange={e =>
                setVenue(e.target.value)
              }
              placeholder="예: 대학로 OO극장"
            />

          </Field>

          <Field label={existing ? '변경 작성자' : '작성자'}>

            <select
              className="input"
              value={author}
              onChange={e =>
                setAuthor(
                  e.target.value as Person
                )
              }
            >

              {PEOPLE.map(p => (
                <option key={p}>
                  {p}
                </option>
              ))}

            </select>

          </Field>

          <div className="mt-3 border-t border-slate-200 pt-7">

            <div className="mb-5">

              <div className="text-lg font-extrabold">
                공연 / 이동 정보
              </div>

              <div className="mt-1 text-sm text-slate-500">
                필요한 정보만 입력하고 대시보드에 보여줄 항목을 선택하세요.
              </div>

            </div>

            <div className="grid gap-5 sm:grid-cols-2">

              <Field label="공연 날짜 / 기간">

                <input
                  type="text"
                  className="input"
                  value={
                    tour.performanceDateText ||
                    ''
                  }
                  onChange={e =>
                    setT(
                      'performanceDateText',
                      e.target.value
                    )
                  }
                  placeholder="예: 9/12 · 9/12~10/18 · 매주 토·일"
                />

              </Field>

              <div className="hidden sm:block" />

              <div>

                <div className="grid gap-3 sm:grid-cols-2">

                  <Field label="출발지">

                    <input
                      className="input"
                      value={
                        tour.departureCity ||
                        ''
                      }
                      onChange={e =>
                        setT(
                          'departureCity',
                          e.target.value
                        )
                      }
                      placeholder="예: 서울"
                    />

                  </Field>

                  <Field label="도착지">

                    <input
                      className="input"
                      value={
                        tour.arrivalCity ||
                        ''
                      }
                      onChange={e =>
                        setT(
                          'arrivalCity',
                          e.target.value
                        )
                      }
                      placeholder="예: 대구"
                    />

                  </Field>

                  <Field label="출발">

                    <input
                      type="text"
                      className="input"
                      value={tour.departure}
                      onChange={e =>
                        setT(
                          'departure',
                          e.target.value
                        )
                      }
                      placeholder="예: 오전 8시 40분"
                    />

                  </Field>

                  <Field label="도착">

                    <input
                      type="text"
                      className="input"
                      value={tour.arrival}
                      onChange={e =>
                        setT(
                          'arrival',
                          e.target.value
                        )
                      }
                      placeholder="예: 10:25 예정"
                    />

                  </Field>

                </div>

                <DashboardCheck value="move" />

              </div>

              <div>

                <div className="grid gap-3 sm:grid-cols-2">

                  <Field label="숙소">

                    <input
                      className="input"
                      value={tour.hotel}
                      onChange={e =>
                        setT(
                          'hotel',
                          e.target.value
                        )
                      }
                      placeholder="예: OO호텔"
                    />

                  </Field>

                  <Field label="체크인">

                    <input
                      type="text"
                      className="input"
                      value={tour.checkIn}
                      onChange={e =>
                        setT(
                          'checkIn',
                          e.target.value
                        )
                      }
                      placeholder="예: 오후 3시 이후"
                    />

                  </Field>

                </div>

                <DashboardCheck value="hotel" />

              </div>

              <div>

                <Field label="공연장">

                  <input
                    className="input"
                    value={tour.venue}
                    onChange={e =>
                      setT(
                        'venue',
                        e.target.value
                      )
                    }
                    placeholder="예: 대구 OO아트센터"
                  />

                </Field>

                <DashboardCheck value="venue" />

              </div>

              <div>

                <Field label="콜타임">

                  <input
                    type="text"
                    className="input"
                    value={tour.callTime}
                    onChange={e =>
                      setT(
                        'callTime',
                        e.target.value
                      )
                    }
                    placeholder="예: 오후 1시 / 공연 2시간 전"
                  />

                </Field>

                <DashboardCheck value="callTime" />

              </div>

              <div>

                <Field label="공연 시간">

                  <input
                    type="text"
                    className="input"
                    value={tour.performanceTime}
                    onChange={e =>
                      setT(
                        'performanceTime',
                        e.target.value
                      )
                    }
                    placeholder="예: 오후 5시 / 15시·19시"
                  />

                </Field>

                <DashboardCheck value="performance" />

              </div>

              <div>

                <div className="grid gap-3 sm:grid-cols-2">

                  <Field label="현지 담당자">

                    <input
                      className="input"
                      value={tour.localContact}
                      onChange={e =>
                        setT(
                          'localContact',
                          e.target.value
                        )
                      }
                      placeholder="예: 김OO"
                    />

                  </Field>

                  <Field label="연락처">

                    <input
                      type="text"
                      className="input"
                      value={tour.localPhone}
                      onChange={e =>
                        setT(
                          'localPhone',
                          e.target.value
                        )
                      }
                      placeholder="010-0000-0000"
                    />

                  </Field>

                </div>

                <DashboardCheck value="localContact" />

              </div>

              <div>

                <div className="grid gap-3 sm:grid-cols-2">

                  <Field label="장비 이동 내용">

                    <input
                      className="input"
                      value={
                        tour.equipmentNote ||
                        ''
                      }
                      onChange={e =>
                        setT(
                          'equipmentNote',
                          e.target.value
                        )
                      }
                      placeholder="예: 음향·조명 장비"
                    />

                  </Field>

                  <Field label="차량 출발">

                    <input
                      type="text"
                      className="input"
                      value={tour.equipmentDeparture}
                      onChange={e =>
                        setT(
                          'equipmentDeparture',
                          e.target.value
                        )
                      }
