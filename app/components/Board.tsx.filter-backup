function AddModal({
  data,
  mode,
  setMode,
  onClose,
  addSchedule,
  addTask
}: {
  data: AppData
  mode: AddMode
  setMode: (m: AddMode) => void
  onClose: () => void
  addSchedule: (
    item: Omit<
      ScheduleItem,
      'id'
    >
  ) => void
  addTask: (
    item: Omit<
      TaskItem,
      'id' | 'done'
    >
  ) => void
}) {
  const [showId, setShowId] =
    useState(
      data.shows[0]?.id ||
        ''
    )

  const [title, setTitle] =
    useState('')

  const [date, setDate] =
    useState(TODAY)

  const [
    startTime,
    setStartTime
  ] = useState('10:00')

  const [
    endTime,
    setEndTime
  ] = useState('')

  const [
    location,
    setLocation
  ] = useState('')

  const [person, setPerson] =
    useState<Person>(
      PEOPLE[0]
    )

  const [memo, setMemo] =
    useState('')

  const save = () => {
    if (!showId) {
      return alert(
        '먼저 공연을 만들어 주세요.'
      )
    }

    if (!title.trim()) {
      return alert(
        '제목을 입력해 주세요.'
      )
    }

    if (
      mode ===
      'schedule'
    ) {
      addSchedule({
        showId,
        title:
          title.trim(),
        date,
        startTime,
        endTime:
          endTime ||
          undefined,
        location:
          location ||
          undefined,
        author: person,
        memo:
          memo ||
          undefined
      })
    } else {
      addTask({
        showId,
        title:
          title.trim(),
        assignee: person,
        dueDate: date,
        memo:
          memo ||
          undefined
      })
    }

    onClose()
  }

  return (
    <ModalShell
      title="추가"
      onClose={onClose}
    >

      <div className="grid grid-cols-2 rounded-lg bg-slate-100 p-1">

        <button
          onClick={() =>
            setMode(
              'schedule'
            )
          }
          className={`rounded-md py-2 text-sm font-bold ${
            mode ===
            'schedule'
              ? 'bg-white shadow-sm'
              : 'text-slate-500'
          }`}
        >
          일정
        </button>

        <button
          onClick={() =>
            setMode(
              'task'
            )
          }
          className={`rounded-md py-2 text-sm font-bold ${
            mode ===
            'task'
              ? 'bg-white shadow-sm'
              : 'text-slate-500'
          }`}
        >
          할 일
        </button>

      </div>

      <div className="mt-5 grid gap-4">

        <Field label="공연">

          <select
            value={showId}
            onChange={e =>
              setShowId(
                e.target.value
              )
            }
            className="input"
          >
            {data.shows.map(
              s => (
                <option
                  key={s.id}
                  value={s.id}
                >
                  {s.name}
                </option>
              )
            )}
          </select>

        </Field>

        <Field
          label={
            mode ===
            'schedule'
              ? '제목'
              : '할 일'
          }
        >

          <input
            value={title}
            onChange={e =>
              setTitle(
                e.target.value
              )
            }
            className="input"
            placeholder={
              mode ===
              'schedule'
                ? '예: 제작회의'
                : '예: 공연장 담당자 연락'
            }
          />

        </Field>

        <div className="grid grid-cols-2 gap-3">

          <Field
            label={
              mode ===
              'schedule'
                ? '날짜'
                : '마감일'
            }
          >
            <input
              type="date"
              value={date}
              onChange={e =>
                setDate(
                  e.target.value
                )
              }
              className="input"
            />
          </Field>

          {mode ===
          'schedule' ? (
            <Field label="시작시간">
              <input
                type="time"
                value={
                  startTime
                }
                onChange={e =>
                  setStartTime(
                    e.target.value
                  )
                }
                className="input"
              />
            </Field>
          ) : (
            <Field label="담당자">

              <select
                value={person}
                onChange={e =>
                  setPerson(
                    e.target.value as Person
                  )
                }
                className="input"
              >

                {PEOPLE.map(
                  p => (
                    <option
                      key={p}
                    >
                      {p}
                    </option>
                  )
                )}

              </select>

            </Field>
          )}

        </div>

        {mode ===
          'schedule' && (
          <>

            <div className="grid grid-cols-2 gap-3">

              <Field label="종료시간">

                <input
                  type="time"
                  value={
                    endTime
                  }
                  onChange={e =>
                    setEndTime(
                      e.target.value
                    )
                  }
                  className="input"
                />

              </Field>

              <Field label="작성자">

                <select
                  value={person}
                  onChange={e =>
                    setPerson(
                      e.target.value as Person
                    )
                  }
                  className="input"
                >
                  {PEOPLE.map(
                    p => (
                      <option
                        key={p}
                      >
                        {p}
                      </option>
                    )
                  )}
                </select>

              </Field>

            </div>

            <Field label="장소">

              <input
                value={
                  location
                }
                onChange={e =>
                  setLocation(
                    e.target.value
                  )
                }
                className="input"
                placeholder="선택 입력"
              />

            </Field>

          </>
        )}

        <Field label="메모">

          <textarea
            value={memo}
            onChange={e =>
              setMemo(
                e.target.value
              )
            }
            rows={2}
            className="input resize-none"
            placeholder="선택 입력"
          />

        </Field>

      </div>

      <button
        onClick={save}
        className="mt-5 w-full rounded-lg bg-slate-900 py-3.5 text-sm font-extrabold text-white"
      >
        저장
      </button>

    </ModalShell>
  )
}

