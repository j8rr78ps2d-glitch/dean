        <Section title="자료">

          <div className="border-b border-slate-100 px-4 py-3">

            <button
              onClick={
                onAddResource
              }
              className="inline-flex items-center gap-1 text-xs font-extrabold text-slate-600"
            >
              <Plus
                size={14}
              />
              자료 링크 추가
            </button>

          </div>

          {resources.length ===
          0 ? (
            <Empty text="등록된 자료가 없습니다." />
          ) : (
            resources.map(
              (r, i) => (
                <div
                  key={r.id}
                  className={`flex items-center justify-between gap-3 px-4 py-3.5 ${
                    i
                      ? 'border-t border-slate-100'
                      : ''
                  }`}
                >

                  <a
                    href={r.url}
                    target="_blank"
                    rel="noreferrer"
                    className="flex min-w-0 items-center gap-2 font-bold hover:underline"
                  >
                    <FileText
                      size={16}
                      className="shrink-0 text-slate-400"
                    />

                    <span className="truncate">
                      {r.label}
                    </span>

                    <ExternalLink
                      size={13}
                      className="shrink-0 text-slate-400"
                    />
                  </a>

                  <div className="flex shrink-0">

                    <IconButton
                      label="수정"
                      onClick={() =>
                        onEdit({
                          kind:
                            'resource',
                          item: r
                        })
                      }
                    />

                    <IconButton
                      label="삭제"
                      danger
                      onClick={() =>
                        deleteResource(
                          r.id
                        )
                      }
                    />

                  </div>

                </div>
              )
            )
          )}

        </Section>

        <Section title="최근 변경">

          {changes.length ===
          0 ? (
            <Empty text="최근 변경사항이 없습니다." />
          ) : (
            changes.map(
              (c, i) => (
                <ChangeRow
                  key={c.id}
                  c={c}
                  showName={
                    show.name
                  }
                  border={i > 0}
                />
              )
            )
          )}

        </Section>

      </div>

    </div>
  )
}

function TourPanel({
  show
}: {
  show: Show
}) {
  const t =
    show.tourInfo as ExtendedTourInfo

  const [routeDeparture, routeArrival] =
    splitRoute(t.route)

  const departureCity =
    t.departureCity ||
    routeDeparture

  const arrivalCity =
    t.arrivalCity ||
    routeArrival

  const visible = {
    move: true,
    hotel: true,
    venue: true,
    callTime: true,
    performance: true,
    localContact: false,
    equipment: false,
    ...(t.dashboardVisible || {})
  }

  const cells = [
    visible.move && [
      '이동',
      `${
        departureCity ||
        '미정'
      } → ${
        arrivalCity ||
        '미정'
      }\n${
        t.departure ||
        '미정'
      } 출발 · ${
        t.arrival ||
        '미정'
      } 도착`
    ],

    visible.hotel && [
      '숙소',
      `${
        t.hotel ||
        '미정'
      }${
        t.checkIn
          ? `\n체크인 ${t.checkIn}`
          : ''
      }`
    ],

    visible.venue && [
      '공연장',
      t.venue || '미정'
    ],

    visible.callTime && [
      '콜타임',
      t.callTime || '미정'
    ],

    visible.performance && [
      '공연',
      t.performanceTime ||
        '미정'
    ],

    visible.localContact && [
      '현지 담당자',
      `${
        t.localContact ||
        '미정'
      }${
        t.localPhone
          ? `\n${t.localPhone}`
          : ''
      }`
    ],

    visible.equipment && [
      '장비 이동',
      `${
        t.equipmentNote ||
        '내용 미정'
      }${
        t.equipmentDeparture
          ? `\n차량 출발 ${t.equipmentDeparture}`
          : ''
      }`
    ]
  ].filter(Boolean) as string[][]

  const dateLabel =
    t.performanceDateText?.trim()
      ? t.performanceDateText
      : t.date
        ? fmtLongDate(t.date)
        : '공연 날짜 미정'

  return (
    <section className="rounded-lg border border-slate-200 bg-white p-5">

      <div className="mb-4">

        <div className="text-xs font-extrabold text-slate-500">
          지방공연 정보
        </div>

        <div className="mt-1 text-xl font-extrabold">
          {dateLabel}
        </div>

      </div>

      {cells.length === 0 ? (
        <div className="rounded-md border border-slate-200 bg-white px-4 py-6 text-sm text-slate-400">
          대시보드에 표시할 정보를 선택해 주세요.
        </div>
      ) : (
        <div className="grid gap-px overflow-hidden rounded-md border border-slate-200 bg-slate-200 sm:grid-cols-2 lg:grid-cols-4">

          {cells.map(
            ([label, value]) => (
              <div
                key={label}
                className="bg-white p-4"
              >

                <div className="text-xs font-bold text-slate-500">
                  {label}
                </div>

                <div className="mt-1 whitespace-pre-line text-sm font-bold leading-6">
                  {value}
                </div>

              </div>
            )
          )}

        </div>
      )}

    </section>
  )
}

function TasksView({
  data,
  showMap,
  toggleTask,
  deleteTask,
  onEdit
}: {
  data: AppData
  showMap: Record<string, Show>
  toggleTask: (id: string) => void
  deleteTask: (id: string) => void
  onEdit: (item: TaskItem) => void
}) {
  const weekEnd =
    new Date(
      `${TODAY}T00:00:00`
    )

  weekEnd.setDate(
    weekEnd.getDate() + 7
  )

  const endKey =
    `${weekEnd.getFullYear()}-${String(
      weekEnd.getMonth() + 1
    ).padStart(2, '0')}-${String(
      weekEnd.getDate()
    ).padStart(2, '0')}`

  const groups = [
    [
      '오늘',
      data.tasks.filter(
        t =>
          t.dueDate <= TODAY
      )
    ],
    [
      '이번 주',
      data.tasks.filter(
        t =>
          t.dueDate >
            TODAY &&
          t.dueDate <=
            endKey
      )
    ],
    [
      '나중',
      data.tasks.filter(
        t =>
          t.dueDate >
          endKey
      )
    ]
  ] as [
    string,
    TaskItem[]
  ][]

  return (
    <div>

      <div className="mb-8">

        <div className="text-sm font-semibold text-slate-500">
          전체 공연
        </div>

        <h1 className="mt-1 text-3xl font-extrabold tracking-tight">
          할 일
        </h1>

      </div>

      <div className="space-y-7">

        {groups.map(
          ([label, tasks]) => (
            <section key={label}>

              <h2 className="mb-3 text-lg font-bold">
                {label}
              </h2>

              <div className="rounded-lg border border-slate-200 bg-white">

                {tasks.length ===
                0 ? (
                  <Empty text="할 일이 없습니다." />
                ) : (
                  tasks
                    .sort(
                      (a, b) =>
                        a.dueDate.localeCompare(
                          b.dueDate
                        )
                    )
                    .map(
                      (t, i) => (
                        <div
                          key={t.id}
                          className={`flex items-center justify-between gap-3 px-4 py-4 ${
                            i
                              ? 'border-t border-slate-100'
                              : ''
                          }`}
                        >

                          <TaskRow
                            t={t}
                            showName={
                              showMap[
                                t.showId
                              ]?.name
                            }
                            toggle={
                              toggleTask
                            }
                            border={
                              false
                            }
                            bare
                          />

                          <div className="flex shrink-0">

                            <IconButton
                              label="수정"
                              onClick={() =>
                                onEdit(
                                  t
                                )
                              }
                            />

                            <IconButton
                              label="삭제"
                              danger
                              onClick={() =>
                                deleteTask(
                                  t.id
                                )
                              }
                            />

                          </div>

                        </div>
                      )
                    )
                )}

              </div>

            </section>
          )
        )}

      </div>

    </div>
  )
}

